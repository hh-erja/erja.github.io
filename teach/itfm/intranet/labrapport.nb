Cell[CellGroupData[{

Cell["\<\
L\[ARing]t m\[ADoubleDot]ngderna A, B, C och D vara definierade enligt\
\[LineSeparator]A = {6,8.9,10}   B = {4,5,6,8,10}   C = {4,6,7,8,9}   D = \
{5,6,7,9,10}\
\>", "ItemNumbered",
