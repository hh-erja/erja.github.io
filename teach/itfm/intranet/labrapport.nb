Cell[TextData[{
 "\n\nD\[ARing] alla uppgifter besvarats efter b\[ADoubleDot]sta f\
\[ODoubleDot]rm\[ARing]ga, spara rapporten b\[ARing]de som en notebook (dvs \
en .nb-fil) och som en pdf-fil och emaila b\[ARing]da tv\[ARing]  till mig p\
\[ARing] ",
 StyleBox["eric.jarpe@hh.se",
  FontFamily->"LM Mono 12"],
 ". Rapporten ska vara inl\[ADoubleDot]mnad ",
 StyleBox["senast",
  FontSlant->"Italic"],
 " det sista inl\[ADoubleDot]mningsdatum som finns angivet p\[ARing] \
kurshemsidan, men man f\[ARing]r givetvis g\[ADoubleDot]rna l\[ADoubleDot]mna \
in den tidigare."
}], "Text",
