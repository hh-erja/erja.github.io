Cell[CellGroupData[{

Cell["Laboration Mathematica", "Title",
 CellChangeTimes->{{3.843318290775949*^9, 
  3.843318298804838*^9}},ExpressionUUID->"e03bf163-f0cb-4c9e-aeec-\
cfc9711af468"],

Cell["\<\
I denna laboration \[ADoubleDot]r tanken att man ska f\[ARing] en \
introduktion till programvaran Mahtematica.
F\[ODoubleDot]r att evaluera ett uttryck, st\[ADoubleDot]ll \
mark\[ODoubleDot]ren brevid och tryck SHIFT + ENTER.
F\[ODoubleDot]r att ta bort text eller output som inte ska vara med i \
rapporten, markera motsvarande stycke med hakparentesen l\[ADoubleDot]ngst ut \
till h\[ODoubleDot]ger och tryck DELETE.\
\>", "Text",
 CellChangeTimes->{{3.8433185918903008`*^9, 3.84331871118253*^9}, {
  3.904875805448987*^9, 
  3.904875810482461*^9}},ExpressionUUID->"e3df686f-2d4c-4731-b496-\
69f745ecbb8d"],

Cell[TextData[{
 StyleBox["OBS! ",
  FontWeight->"Bold"],
 "Alla ber\[ADoubleDot]kningar ska genomf\[ODoubleDot]ras i Mathematica och \
koden f\[ODoubleDot]r dem (input) och deras output ska vara redovisad. \
Laborationen ska utf\[ODoubleDot]ras i grupper om tv\[ARing] och tv\[ARing]."
}], "Text",
 CellFrame->{{0, 0}, {0.5, 0}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.843318788387293*^9, 3.843318911288931*^9}, 
   3.84331895898006*^9},ExpressionUUID->"5d06cc91-e9c7-48ed-9bde-\
46627d0e28d7"],

